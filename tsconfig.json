{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vite/client", "node"],
    "paths": {
      "@tex/core": ["./packages/core/src/index.ts"],
      "@tex/core/*": ["./packages/core/src/*"],
      "@tex/ui": ["./packages/ui/src/index.ts"],
      "@tex/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "apps/**/*.ts", "apps/**/*.tsx"],
  "exclude": ["node_modules", "dist", "web-dist"]
}
